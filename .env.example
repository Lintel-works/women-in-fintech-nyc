# Luma calendar API key — required by /api/events.
#
# Get it at luma.com/calendar/manage/api-keys (Settings -> Developer).
# Requires a Luma Plus subscription on that calendar.
#
# This key grants FULL access to the calendar it is scoped to, including
# creating/cancelling events and reading guest lists. Never commit it, never
# expose it to the browser, never paste it into a client-side file.
LUMA_API_KEY=

# Clerk owns authors and admins. CLERK_PUBLISHABLE_KEY and
# CLERK_FRONTEND_API_URL are public and are baked into /admin at BUILD time,
# so changing either needs a redeploy, not just an env var edit. The build
# fails outright if either is missing.
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API_URL=
#
# CLERK_SECRET_KEY can invite, list, remove and promote every user, and
# CLERK_PEM_PUBLIC_KEY is what the functions trust a token against. Both are
# server-side only: never commit them, never expose them to the browser, never
# paste them into a client-side file.
CLERK_SECRET_KEY=
CLERK_PEM_PUBLIC_KEY=
# Comma-separated origins allowed in a token's azp claim. A token minted for
# another origin is refused, so this must list the real site origin. It is NOT
# optional: an empty list is a configuration fault that throws, so an unset
# variable can never silently disable origin checking.
CLERK_AUTHORIZED_PARTIES=
# Where an invitation link lands. Must be an allowed redirect in the Clerk
# Dashboard, or Clerk refuses the invitation.
CLERK_INVITE_REDIRECT_URL=

# GitHub App credentials -- required by /api/publish and /api/unpublish, in
# addition to the Clerk variables above. Full setup, including why this is
# a GitHub App and not a personal access token, is in
# docs/publishing-setup.md.
#
# A fresh installation access token is minted from these on every publish or
# unpublish request (lib/github-auth.mjs) -- a token minted once and reused
# would expire an hour after issue (GitHub's own platform behaviour) and
# publishing would then fail permanently with nobody watching to notice.
#
# GITHUB_APP_PRIVATE_KEY is the App's PEM private key. Pasted into a Vercel
# environment variable, its line breaks usually arrive as literal `\n`
# sequences rather than real newlines -- lib/github-auth.mjs normalises
# either form, so paste it however the dashboard gives it to you.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# GITHUB_OWNER/GITHUB_REPO name the repository the editor commits to.
# GITHUB_BRANCH is optional and defaults to main.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=

# GITHUB_TOKEN is a TEST-ONLY override: when set, it is used directly as the
# bearer token instead of minting one from the App credentials above (see
# lib/github-auth.mjs, and tools/github-auth.test.mjs, tools/unpublish.test.mjs
# and tools/publish-handler.test.mjs, which all set it to script GitHub calls
# with no real credential). Leaving it set in PRODUCTION silently reinstates
# the one-hour expiry this whole App-based design exists to avoid -- every
# use of it logs a warning for exactly that reason. Leave it unset in Vercel.
GITHUB_TOKEN=


# ─────────────── Public form submissions ───────────────
# Required by /api/form, which serves the co-founder matching form (and any
# later public form). With none of these set the endpoint answers 503 and the
# page tells the visitor to email instead -- it never pretends to have sent.

# Which provider sends. Optional: when unset it is inferred from whichever API
# key is present, preferring Brevo. Set it explicitly to pin one.
FORM_PROVIDER=

# Brevo is the intended destination. A transactional key from
# app.brevo.com -> SMTP & API -> API keys.
BREVO_API_KEY=

# Resend is the interim, used only if Brevo credentials are not available yet.
# Swapping between them is changing these variables -- no code change, no deploy.
RESEND_API_KEY=

# The sender. This MUST be on a domain verified with the provider (SPF/DKIM)
# or every send is rejected -- it is the likeliest reason a first deploy fails.
# It is NEVER the person who filled in the form: sending as them fails DMARC
# for their domain and files the notification as spam. They are the reply-to.
FORM_FROM_EMAIL=

# Where submissions land.
FORM_TO_EMAIL=

# Optional second copy, delivered in the same API call at no extra cost. Worth
# setting: it is the cheapest backstop if the primary mailbox ever filters one.
FORM_BCC_EMAIL=
