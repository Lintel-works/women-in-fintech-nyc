# Luma calendar API key — required by /api/events.
#
# Get it at luma.com/calendar/manage/api-keys (Settings -> Developer).
# Requires a Luma Plus subscription on that calendar.
#
# This key grants FULL access to the calendar it is scoped to, including
# creating/cancelling events and reading guest lists. Never commit it, never
# expose it to the browser, never paste it into a client-side file.
LUMA_API_KEY=

# Admin sign-in — required by /api/login and /api/publish.
#
# AUTH_SECRET signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs every author out; that is the intended way to do it.
AUTH_SECRET=

# AUTH_USERS maps an email to a scrypt hash. Add an author with:
#   node tools/hash-password.mjs 'their generated password'
# Keys must be lowercase -- /api/login compares the submitted email
# lowercased, so an uppercase key here can never match. Passwords must be
# GENERATED, not chosen: scrypt is deliberately slow, which is the defence
# against repeated guessing since there is no separate rate limiting, but
# that only helps if the password itself has enough entropy to make guessing
# expensive in the first place. Removing an author is deleting their entry.
AUTH_USERS={}

# GitHub App credentials -- required by /api/publish and /api/unpublish, in
# addition to AUTH_SECRET/AUTH_USERS above. Full setup, including why this is
# a GitHub App and not a personal access token, is in
# docs/publishing-setup.md.
#
# A fresh installation access token is minted from these on every publish or
# unpublish request (lib/github-auth.mjs) -- a token minted once and reused
# would expire an hour after issue (GitHub's own platform behaviour) and
# publishing would then fail permanently with nobody watching to notice.
#
# GITHUB_APP_PRIVATE_KEY is the App's PEM private key. Pasted into a Vercel
# environment variable, its line breaks usually arrive as literal `\n`
# sequences rather than real newlines -- lib/github-auth.mjs normalises
# either form, so paste it however the dashboard gives it to you.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# GITHUB_OWNER/GITHUB_REPO name the repository the editor commits to.
# GITHUB_BRANCH is optional and defaults to main.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=

# GITHUB_TOKEN is a TEST-ONLY override: when set, it is used directly as the
# bearer token instead of minting one from the App credentials above (see
# lib/github-auth.mjs, and tools/github-auth.test.mjs, tools/unpublish.test.mjs
# and tools/publish-handler.test.mjs, which all set it to script GitHub calls
# with no real credential). Leaving it set in PRODUCTION silently reinstates
# the one-hour expiry this whole App-based design exists to avoid -- every
# use of it logs a warning for exactly that reason. Leave it unset in Vercel.
GITHUB_TOKEN=

